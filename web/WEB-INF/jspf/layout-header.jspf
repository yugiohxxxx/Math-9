<%@ page contentType="text/html" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="role" value="${sessionScope.user.roleName}"/>
<c:set var="roleLabel" value="${role == 'admin' ? 'Quản trị viên' : (role == 'teacher' ? 'Giáo viên' : (role == 'student' ? 'Học sinh' : ''))}"/>
<%-- Chữ cái đầu của tên (tên tiếng Việt: lấy từ cuối) để làm ảnh đại diện --%>
<c:set var="nameParts" value="${fn:split(sessionScope.user.fullName, ' ')}"/>
<c:set var="initial" value="${fn:length(nameParts) gt 0 ? fn:toUpperCase(fn:substring(nameParts[fn:length(nameParts) - 1], 0, 1)) : '?'}"/>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${empty pageTitle ? 'Toán 9' : pageTitle}"/> | MathTutor</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" rel="stylesheet">
  <link href="${ctx}/assets/css/app.css" rel="stylesheet">
</head>
<body>
<div class="app-shell">

  <!-- ===== Thanh bên ===== -->
  <aside class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Menu chính">
    <div class="offcanvas-header d-lg-none">
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Đóng menu"></button>
    </div>
    <div class="offcanvas-body">
      <a class="brand" href="${ctx}/home">
        <span class="brand-mark">∑</span>
        <span class="brand-name">MathTutor<span class="brand-sub">Gia sư Toán 9</span></span>
      </a>

      <nav class="side-nav">
        <c:if test="${role == 'student'}">
          <div class="nav-group">
            <div class="nav-group-title">Học tập</div>
            <a class="side-link" href="${ctx}/student/home"><i class="bi bi-house-door"></i> Trang chủ</a>
            <a class="side-link" href="${ctx}/student/lessons"><i class="bi bi-journal-richtext"></i> Bài giảng</a>
            <a class="side-link" href="${ctx}/student/practice"><i class="bi bi-pencil-square"></i> Luyện tập</a>
            <a class="side-link" href="${ctx}/student/progress"><i class="bi bi-graph-up-arrow"></i> Tiến độ</a>
          </div>
        </c:if>

        <c:if test="${role == 'admin'}">
          <div class="nav-group">
            <div class="nav-group-title">Quản trị</div>
            <a class="side-link" href="${ctx}/admin/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="side-link" href="${ctx}/admin/users"><i class="bi bi-people"></i> Người dùng</a>
            <a class="side-link" href="${ctx}/admin/textbooks"><i class="bi bi-book"></i> Sách giáo khoa</a>
            <a class="side-link" href="${ctx}/admin/ai-config"><i class="bi bi-robot"></i> Cấu hình AI</a>
          </div>
        </c:if>

        <c:if test="${role == 'teacher'}">
          <div class="nav-group">
            <div class="nav-group-title">Lớp học</div>
            <a class="side-link" href="${ctx}/teacher/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="side-link" href="${ctx}/teacher/students"><i class="bi bi-mortarboard"></i> Học sinh</a>
          </div>
        </c:if>

        <c:if test="${role == 'teacher'}">
          <div class="nav-group">
            <div class="nav-group-title">Nội dung</div>
            <a class="side-link" href="${ctx}/manage/chapters"><i class="bi bi-diagram-3"></i> Chương / Chủ đề</a>
            <a class="side-link" href="${ctx}/manage/lessons"><i class="bi bi-journal-text"></i> Bài giảng</a>
            <a class="side-link" href="${ctx}/manage/questions"><i class="bi bi-patch-question"></i> Ngân hàng câu hỏi</a>
          </div>
        </c:if>
      </nav>

      <div class="sidebar-foot">Chương trình Toán lớp 9</div>
    </div>
  </aside>

  <!-- ===== Nội dung chính ===== -->
  <div class="app-main">
    <header class="app-topbar">
      <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Mở menu">
        <i class="bi bi-list fs-5"></i>
      </button>
      <div class="crumb text-truncate">
        <c:if test="${not empty roleLabel}">${roleLabel} / </c:if><strong><c:out value="${empty pageTitle ? 'Trang chủ' : pageTitle}"/></strong>
      </div>

      <c:if test="${not empty sessionScope.user}">
        <div class="dropdown ms-auto">
          <a class="user-chip dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="avatar"><c:out value="${initial}"/></span>
            <span class="who d-none d-sm-block"><c:out value="${sessionScope.user.fullName}"/><small>${roleLabel}</small></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            <li><a class="dropdown-item text-danger" href="${ctx}/logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
          </ul>
        </div>
      </c:if>
    </header>

    <main class="app-content">
<c:if test="${not empty sessionScope.flash}">
  <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2"><i class="bi bi-info-circle"></i><span><c:out value="${sessionScope.flash}"/></span>
    <button class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div>
  <c:remove var="flash" scope="session"/>
</c:if>
<c:if test="${not empty error}"><div class="alert alert-danger d-flex align-items-center gap-2"><i class="bi bi-exclamation-triangle"></i><span>${error}</span></div></c:if>
