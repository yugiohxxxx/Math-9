    </main>
  </div>
</div>

<!-- jQuery (cần cho DataTables) -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- DataTables -->
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<!-- KaTeX auto-render: tự chuyển $...$ thành công thức -->
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
<!-- Chart.js (dashboard thống kê) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<!-- SweetAlert2 (thông báo đẹp) -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- TinyMCE bản mã nguồn mở (GPL), tự host qua jsDelivr: không cần API key của Tiny Cloud -->
<script src="https://cdn.jsdelivr.net/npm/tinymce@7.9.1/tinymce.min.js"></script>

<script>
  // Bảng màu & font chung cho biểu đồ Chart.js
  if (window.Chart) {
    Chart.defaults.font.family = '"Be Vietnam Pro", system-ui, sans-serif';
    Chart.defaults.color = '#64706c';
    Chart.defaults.borderColor = '#e2e6e3';
    Chart.defaults.plugins.legend.labels.usePointStyle = true;
  }
  window.MT_COLORS = {teal:'#1f7a6c', green:'#2f8a4e', chalk:'#f2c14e', blue:'#3b82a8', grey:'#c9d0cd', board:'#1f4d45'};

  // Ô chọn bài giảng (data-lesson-of="#oChuDe"): chỉ hiện bài thuộc chủ đề đang chọn
  document.querySelectorAll('select[data-lesson-of]').forEach(function (ls) {
    var ts = document.querySelector(ls.getAttribute('data-lesson-of'));
    if (!ts) return;
    function filter() {
      Array.prototype.forEach.call(ls.options, function (o) {
        if (!o.getAttribute('data-topic')) return;
        o.hidden = ts.value !== '' && o.getAttribute('data-topic') !== ts.value;
        if (o.hidden && o.selected) ls.value = '';
      });
    }
    ts.addEventListener('change', filter);
    filter();
  });

  // Tô sáng mục menu đang mở (so khớp đường dẫn hiện tại)
  (function () {
    var path = location.pathname, best = null, bestLen = 0;
    document.querySelectorAll('.side-link').forEach(function (a) {
      var href = a.getAttribute('href');
      if (path === href || path.indexOf(href + '/') === 0 || path.indexOf(href.replace(/s$/, '')) === 0) {
        if (href.length > bestLen) { best = a; bestLen = href.length; }
      }
    });
    if (best) { best.classList.add('active'); best.setAttribute('aria-current', 'page'); }
  })();

  document.addEventListener("DOMContentLoaded", function () {
    renderMathInElement(document.body, {
      delimiters: [{left: "$$", right: "$$", display: true}, {left: "$", right: "$", display: false}]
    });
    if (document.querySelector("table.datatable")) $("table.datatable").DataTable({language: {url: "https://cdn.datatables.net/plug-ins/1.13.8/i18n/vi.json"}});
    if (document.querySelector("textarea.editor")) tinymce.init({
      selector: "textarea.editor", license_key: "gpl", height: 420, menubar: "edit insert format table",
      plugins: "lists link image table code charmap autoresize",
      toolbar: "undo redo | blocks | bold italic underline | bullist numlist | alignleft aligncenter | link image table charmap | code",
      branding: false, promotion: false, entity_encoding: "raw", convert_urls: false,
      content_style: "body{font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:15px}",
      setup: function (ed) { ed.on("change", function () { ed.save(); }); }
    });
  });
</script>
</body>
</html>
